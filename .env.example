# ---------------------------------------------------------------------------
# Food Delivery System - environment configuration
# Copy this file to `.env` before running `docker compose up`.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=food_delivery
POSTGRES_USER=fooddelivery
POSTGRES_PASSWORD=fooddelivery_pass
DB_PORT=5432

# --- Backend API -----------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=8080

# --- Adminer (database web client) ----------------------------------------
ADMINER_PORT=8081
